<script>
  /* ====== PERSONALIZZA QUI ====== */
  const CONFIG = {
    brand: "LUMA",
    email: "info@luma.tn.it",
    zone:  "Trentino-Alto Adige"
  };
  /* ============================== */

  document.getElementById("brandName").textContent = CONFIG.brand;
  document.getElementById("brandFoot").textContent = CONFIG.brand;
  document.getElementById("cMail").textContent = CONFIG.email;
  document.getElementById("cZone").textContent = CONFIG.zone;
  document.getElementById("year").textContent = new Date().getFullYear();

  // I pulsanti dei pacchetti preselezionano il menu nel modulo
  document.querySelectorAll("[data-plan]").forEach(function (b) {
    b.addEventListener("click", function () {
      var sel = document.getElementById("pacchetto");
      for (var i = 0; i < sel.options.length; i++) {
        if (sel.options[i].text.indexOf(b.dataset.plan) === 0) { sel.selectedIndex = i; }
      }
    });
  });

  // Il modulo apre il client di posta con i dati compilati
  document.getElementById("contactForm").addEventListener("submit", function (e) {
    e.preventDefault();
    var f = e.target;
    var body = [
      "Nome: " + f.nome.value,
      "Attività: " + f.attivita.value,
      "Telefono: " + f.tel.value,
      "Email: " + f.email.value,
      "Pacchetto: " + f.pacchetto.value,
      "",
      f.msg.value
    ].join("\n");
    window.location.href = "mailto:" + CONFIG.email +
      "?subject=" + encodeURIComponent("Richiesta preventivo sito web") +
      "&body=" + encodeURIComponent(body);
  });

  (function () {
    var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var doc = document.documentElement;

    // Barra di avanzamento, intestazione e barra rapida su telefono
    var bar = document.getElementById("progress");
    var head = document.querySelector("header");
    function onScroll() {
      var max = doc.scrollHeight - doc.clientHeight;
      bar.style.width = (max > 0 ? (doc.scrollTop / max) * 100 : 0) + "%";
      head.classList.toggle("scrolled", doc.scrollTop > 10);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    onScroll();

    if ("IntersectionObserver" in window) {
      // Comparsa dolce dei blocchi principali, una sola volta
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } });
      }, { threshold: 0.12 });
      document.querySelectorAll(".rv").forEach(function (el) { io.observe(el); });
    } else {
      document.querySelectorAll(".rv").forEach(function (el) { el.classList.add("in"); });
    }

    // Il faro: segue il mouse nell'intestazione, di notte "respira" da solo
    var hero = document.querySelector(".hero");
    var pointerSeen = false;
    function spot(x, y) {
      var r = hero.getBoundingClientRect();
      hero.style.setProperty("--mx", (x - r.left) + "px");
      hero.style.setProperty("--my", (y - r.top) + "px");
    }
    if (!reduce) {
      hero.addEventListener("pointermove", function (e) { pointerSeen = true; spot(e.clientX, e.clientY); });
      var t0 = performance.now();
      (function drift(now) {
        if (!pointerSeen) {
          var r = hero.getBoundingClientRect();
          var k = (now - t0) / 2600;
          spot(r.left + r.width * (0.5 + 0.28 * Math.cos(k)), r.top + r.height * (0.42 + 0.22 * Math.sin(k * 1.3)));
        }
        requestAnimationFrame(drift);
      })(t0);
    }


    // Particelle che si muovono ai lati della pagina e reagiscono a mouse e scroll
    (function () {
      var cv = document.getElementById("fx");
      if (!cv || !cv.getContext) return;
      var ctx = cv.getContext("2d");
      var W = 0, H = 0, P = [], mx = -999, my = -999, lastY = window.scrollY || 0, kick = 0;
      var COLS = ["127,176,255", "127,176,255", "62,224,245", "62,224,245", "255,138,61"];
      function edgeX() {
        if (Math.random() < 0.28) { return Math.random() * W; }
        var m = Math.max(120, (W - 1160) / 2 + 50), x = Math.random() * m;
        return Math.random() < 0.5 ? x : W - x;
      }
      function init() {
        var DPR = Math.min(window.devicePixelRatio || 1, 2);
        W = window.innerWidth; H = window.innerHeight;
        cv.width = W * DPR; cv.height = H * DPR;
        ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
        var n = Math.round(Math.min(64, Math.max(26, W / 22)));
        P = [];
        for (var i = 0; i < n; i++) {
          P.push({ x: edgeX(), y: Math.random() * H, r: Math.random() * 1.7 + 0.8,
                   vx: (Math.random() - 0.5) * 0.3, vy: -(Math.random() * 0.35 + 0.08),
                   c: COLS[(Math.random() * COLS.length) | 0], a: Math.random() * 0.45 + 0.35 });
        }
      }
      function frame() {
        ctx.clearRect(0, 0, W, H);
        var sy = window.scrollY || 0; kick += ((sy - lastY) - kick) * 0.2; lastY = sy;
        var i, j, p, q, dx, dy, d;
        for (i = 0; i < P.length; i++) {
          p = P[i];
          dx = p.x - mx; dy = p.y - my; d = Math.sqrt(dx * dx + dy * dy);
          if (d < 130 && d > 0) { p.x += (dx / d) * (130 - d) * 0.02; p.y += (dy / d) * (130 - d) * 0.02; }
          p.x += p.vx; p.y += p.vy - kick * 0.06 * p.r;
          if (p.y < -10) { p.y = H + 10; p.x = edgeX(); }
          if (p.y > H + 10) { p.y = -10; p.x = edgeX(); }
          if (p.x < -10) { p.x = W + 10; } else if (p.x > W + 10) { p.x = -10; }
        }
        for (i = 0; i < P.length; i++) {
          p = P[i];
          for (j = i + 1; j < P.length; j++) {
            q = P[j]; dx = p.x - q.x; dy = p.y - q.y; d = dx * dx + dy * dy;
            if (d < 19600) {
              ctx.strokeStyle = "rgba(127,176,255," + ((1 - Math.sqrt(d) / 140) * 0.22).toFixed(3) + ")";
              ctx.lineWidth = 1; ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y); ctx.stroke();
            }
          }
        }
        for (i = 0; i < P.length; i++) {
          p = P[i];
          ctx.fillStyle = "rgba(" + p.c + "," + p.a + ")";
          ctx.shadowColor = "rgba(" + p.c + ",.9)"; ctx.shadowBlur = 10;
          ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, 6.2832); ctx.fill();
        }
        ctx.shadowBlur = 0;
        if (!reduce) { requestAnimationFrame(frame); }
      }
      window.addEventListener("pointermove", function (e) { mx = e.clientX; my = e.clientY; }, { passive: true });
      window.addEventListener("resize", function () { init(); if (reduce) { frame(); } });
      init(); frame();
    })();

    // Schede dei servizi
    var tabs = document.querySelector("[data-tabs]");
    var btns = tabs.querySelectorAll('[role="tab"]');
    var panels = tabs.querySelectorAll('[role="tabpanel"]');
    function show(i, focus) {
      btns.forEach(function (b, j) {
        b.setAttribute("aria-selected", j === i ? "true" : "false");
        b.tabIndex = j === i ? 0 : -1;
      });
      panels.forEach(function (p, j) { p.hidden = j !== i; });
      if (focus) { btns[i].focus(); }
    }
    btns.forEach(function (b, i) {
      b.addEventListener("click", function () { show(i); });
      b.addEventListener("keydown", function (e) {
        var k = e.key, n = btns.length;
        if (k === "ArrowDown" || k === "ArrowRight") { e.preventDefault(); show((i + 1) % n, true); }
        if (k === "ArrowUp" || k === "ArrowLeft") { e.preventDefault(); show((i - 1 + n) % n, true); }
      });
    });
    tabs.setAttribute("data-ready", "");
    show(0);
  })();
</script>
