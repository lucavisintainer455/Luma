  footer{padding:38px 0 46px;color:var(--muted);font-size:.9rem;text-align:center;border-top:1px solid var(--line);background:var(--night)}
  .foot-logo{height:22px;width:auto;display:block;margin:0 auto 16px;opacity:.9}


  /* ---------- MOVIMENTO AI LATI ---------- */
  #fx{position:fixed;inset:0;width:100%;height:100%;z-index:0;pointer-events:none}
  main,footer{position:relative;z-index:1}
  .side{position:fixed;inset:0;z-index:0;pointer-events:none;display:none}
  @media(min-width:1300px){.side{display:block}}
  .rail{position:absolute;top:0;bottom:0;width:1px;background:linear-gradient(180deg,transparent,rgba(120,150,255,.28) 18%,rgba(120,150,255,.28) 82%,transparent)}
  .rail::after{content:"";position:absolute;left:-1px;top:-160px;width:3px;height:140px;border-radius:3px;background:linear-gradient(180deg,transparent,var(--cyan),transparent);filter:drop-shadow(0 0 6px var(--cyan));animation:pulse 7s linear infinite}
  .rail.l{left:calc((100vw - 1160px)/2 - 30px)}
  .rail.r{right:calc((100vw - 1160px)/2 - 30px)}
  .rail.r::after{animation-delay:-3.5s;background:linear-gradient(180deg,transparent,var(--ember),transparent);filter:drop-shadow(0 0 6px var(--ember))}
  @keyframes pulse{to{top:100%}}
  .fl{position:absolute;display:grid;place-items:center;width:46px;height:46px;border-radius:14px;color:var(--c,var(--cyan));background:rgba(13,18,48,.7);border:1px solid var(--line2);box-shadow:0 0 30px -6px var(--c,var(--cyan));animation:drift var(--d,11s) ease-in-out var(--dl,0s) infinite}
  .fl .i{width:22px;height:22px}
  .fl.lx{left:max(8px,calc((100vw - 1160px)/2*var(--k,.5) - 23px))}
  .fl.rx{right:max(8px,calc((100vw - 1160px)/2*var(--k,.5) - 23px))}
  @keyframes drift{0%,100%{transform:translate(0,0) rotate(-6deg)}50%{transform:translate(var(--dx,12px),-38px) rotate(8deg)}}

  /* comparsa dolce, una volta sola */
  .js .rv{opacity:0;translate:0 18px;transition:opacity .7s ease,translate .7s cubic-bezier(.2,.7,.2,1)}
  .js .rv.in{opacity:1;translate:0 0}
  @media(prefers-reduced-motion:reduce){
    *,*::before,*::after{animation:none!important;transition:none!important}
    .js .rv{opacity:1;translate:none}
    html{scroll-behavior:auto}
  }
