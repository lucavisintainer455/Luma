<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>LUMA | Il tuo sito web professionale da 24,90 €/mese | Dominio, hosting ed email inclusi</title>
<meta name="description" content="Sito web professionale per piccole attività: landing page, dominio, hosting, SSL ed email incluse. Pacchetti da 24,90 €/mese, senza pensieri tecnici.">
<meta name="theme-color" content="#070A1C">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&display=swap" rel="stylesheet">
<script>document.documentElement.classList.add("js")</script>
<style>
  @property --a{syntax:"<angle>";inherits:false;initial-value:0deg}
  :root{
    --night:#070A1C;
    --ink:#0D1230;
    --ink2:#141B42;
    --text:#EEF1FF;
    --muted:#A3ADD0;
    --line:rgba(255,255,255,.1);
    --line2:rgba(255,255,255,.2);
    --cyan:#3EE0F5;
    --indigo:#8A9BFF;
    --ember:#FF8A3D;
    --rose:#FF4D8D;
    --ok:#3DE08F;
    --f-display:"Bricolage Grotesque","Segoe UI",system-ui,sans-serif;
    --f-body:"DM Sans",system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth;scroll-padding-top:84px}
  body{
    font-family:var(--f-body);font-size:1.05rem;line-height:1.65;color:var(--text);
    background:
      radial-gradient(1000px 700px at 100% 0%,rgba(91,110,255,.16),transparent 60%),
      radial-gradient(900px 700px at 0% 55%,rgba(62,224,245,.07),transparent 60%),
      radial-gradient(900px 700px at 100% 90%,rgba(255,77,141,.08),transparent 60%),
      var(--night);
    background-attachment:fixed;
    -webkit-font-smoothing:antialiased;overflow-x:hidden;
  }
  a{color:inherit}
  ::selection{background:var(--cyan);color:var(--night)}
  :focus-visible{outline:2px solid var(--cyan);outline-offset:3px;border-radius:6px}
  .container{width:min(1160px,92%);margin-inline:auto}
  .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  .i{width:1.35em;height:1.35em;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}

  h1,h2,h3{font-family:var(--f-display);line-height:1.06;letter-spacing:-.025em;text-wrap:balance}
  h2{font-size:clamp(2rem,4.2vw,3.3rem);font-weight:800}
  h3{font-weight:700}
  p{text-wrap:pretty}
  .lead{color:var(--muted);font-size:1.12rem;max-width:46ch}

  .sec{padding:clamp(70px,9vw,124px) 0}
  .sec-head{display:grid;grid-template-columns:1.15fr .85fr;gap:20px 64px;align-items:end;margin-bottom:clamp(36px,5vw,60px)}
  .sec-head .lead{justify-self:end}
  @media(max-width:860px){.sec-head{grid-template-columns:1fr}.sec-head .lead{justify-self:start}}
  .band{background:linear-gradient(180deg,rgba(255,255,255,.035),rgba(255,255,255,.015));border-block:1px solid var(--line)}

  .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:15px 28px;border-radius:14px;font:700 1rem var(--f-body);text-decoration:none;border:1.5px solid transparent;cursor:pointer;transition:transform .2s,box-shadow .2s,background-color .2s,border-color .2s,color .2s}
  .btn-primary{background:var(--ember);color:#1B0E04;box-shadow:0 12px 32px -10px rgba(255,138,61,.7)}
  .btn-primary:hover{transform:translateY(-2px);background:#FF9B57;box-shadow:0 18px 38px -10px rgba(255,138,61,.8)}
  .btn-ghost{border-color:var(--line2);color:var(--text);background:rgba(255,255,255,.03)}
  .btn-ghost:hover{border-color:var(--cyan);color:var(--cyan);transform:translateY(-2px)}

  #progress{position:fixed;top:0;left:0;height:3px;width:0;z-index:100;background:linear-gradient(90deg,var(--cyan),var(--indigo),var(--rose))}

  /* ---------- HEADER ---------- */
  header{position:sticky;top:0;z-index:60;background:rgba(7,10,28,.55);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid transparent;transition:background-color .3s,border-color .3s}
  header.scrolled{background:rgba(7,10,28,.88);border-bottom-color:var(--line)}
  .nav{display:flex;align-items:center;justify-content:space-between;height:74px}
  .logo{display:flex;align-items:center;text-decoration:none}
  .logo-img{height:28px;width:auto;display:block;filter:drop-shadow(0 0 14px rgba(62,224,245,.35));transition:filter .3s}
  .logo:hover .logo-img{filter:drop-shadow(0 0 22px rgba(138,155,255,.8))}
  nav ul{display:flex;gap:30px;list-style:none;align-items:center}
  nav a:not(.btn){text-decoration:none;font-weight:500;color:var(--muted);font-size:.95rem;transition:color .2s}
  nav a:not(.btn):hover{color:#fff}
  nav .btn{padding:10px 20px;font-size:.92rem}
  @media(max-width:940px){nav li:not(:last-child){display:none}}

  /* ---------- HERO ---------- */
  .hero{position:relative;overflow:hidden;padding:clamp(36px,5vw,64px) 0 clamp(64px,8vw,104px);--mx:72%;--my:34%}
  .hero-bg{position:absolute;inset:0;pointer-events:none}
  .hero-bg::before{content:"";position:absolute;inset:0;background:radial-gradient(560px circle at var(--mx) var(--my),rgba(62,224,245,.15),transparent 65%)}
  .hero-bg::after{content:"";position:absolute;inset:0;background-image:radial-gradient(rgba(255,255,255,.7) 1px,transparent 1.3px);background-size:28px 28px;-webkit-mask-image:radial-gradient(360px circle at var(--mx) var(--my),#000 0%,transparent 72%);mask-image:radial-gradient(360px circle at var(--mx) var(--my),#000 0%,transparent 72%);opacity:.55}
  .hero-grid{position:relative;display:grid;grid-template-columns:1.1fr .9fr;gap:clamp(32px,5vw,72px);align-items:center}
  .kicker{display:inline-flex;align-items:center;gap:10px;font-size:.92rem;font-weight:500;color:var(--muted);padding:7px 16px 7px 12px;border-radius:999px;border:1px solid var(--line2);background:rgba(255,255,255,.04);margin-bottom:22px}
  .kicker i{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 0 rgba(61,224,143,.6);animation:ping 2.4s ease-out infinite}
  @keyframes ping{70%{box-shadow:0 0 0 9px rgba(61,224,143,0)}100%{box-shadow:0 0 0 0 rgba(61,224,143,0)}}
  .hero h1{font-size:clamp(2.5rem,5.3vw,4.35rem);font-weight:800;line-height:1.01;letter-spacing:-.04em;color:#F4F6FF;margin-bottom:22px}
  .hero h1 span{background:linear-gradient(90deg,#7FB0FF,#3EE0F5 55%,#7EF0C6);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;color:transparent;-webkit-box-decoration-break:clone;box-decoration-break:clone}
  .hero-copy>p{font-size:1.15rem;color:var(--muted);max-width:50ch;margin-bottom:28px}
  .hero-cta{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:26px}
  .checks{display:flex;gap:10px 22px;flex-wrap:wrap;list-style:none;color:var(--text);font-size:.92rem;font-weight:500}
  .checks li{display:flex;align-items:center;gap:8px}
  .checks .i{color:var(--ok);width:1.15em;height:1.15em;stroke-width:2.4}
  @media(max-width:940px){.hero-grid{grid-template-columns:1fr}}

  /* il sito che si monta da solo */
  .stage{position:relative;padding:34px 0 44px}
  .browser{background:linear-gradient(165deg,rgba(255,255,255,.1),rgba(255,255,255,.03));border:1px solid var(--line2);border-radius:20px;box-shadow:0 40px 90px -20px rgba(0,0,0,.7),0 0 90px rgba(62,224,245,.14);overflow:hidden;backdrop-filter:blur(8px);animation:rise .9s cubic-bezier(.2,.8,.2,1) .2s backwards}
  @keyframes rise{from{opacity:0;transform:translateY(34px) scale(.96)}}
  .bar{display:flex;align-items:center;gap:7px;padding:13px 16px;background:rgba(255,255,255,.05);border-bottom:1px solid var(--line)}
  .bar>i{width:11px;height:11px;border-radius:50%;background:#FF5F57}
  .bar>i:nth-child(2){background:#FEBC2E}.bar>i:nth-child(3){background:#28C840}
  .url{margin-left:12px;flex:1;display:flex;align-items:center;gap:8px;background:rgba(0,0,0,.35);border:1px solid var(--line);border-radius:9px;padding:5px 12px;font-size:.82rem;color:#D9DFFA}
  .url .i{width:.95em;height:.95em;color:var(--ok);stroke-width:2.2;animation:lock .5s ease 2.3s backwards}
  @keyframes lock{from{color:var(--muted);transform:scale(.7)}60%{transform:scale(1.25)}}
  .typed{display:inline-block;overflow:hidden;white-space:nowrap;width:21ch;animation:type 1.5s steps(20) .9s backwards}
  @keyframes type{from{width:0}}
  .page{padding:22px}
  .p-nav{display:flex;align-items:center;gap:12px;margin-bottom:16px;animation:pop .5s ease 2.4s backwards}
  .p-nav b{width:74px;height:11px;border-radius:6px;background:rgba(255,255,255,.5)}
  .p-nav span{width:34px;height:7px;border-radius:5px;background:rgba(255,255,255,.18)}
  .p-nav span:first-of-type{margin-left:auto}
  .p-hero{border-radius:14px;padding:26px 20px 20px;min-height:164px;display:flex;flex-direction:column;justify-content:flex-end;background:linear-gradient(135deg,rgba(74,91,255,.95),rgba(34,211,238,.9));box-shadow:0 14px 34px -10px rgba(34,211,238,.45);animation:pop .6s ease 2.7s backwards}
  .p-title{font:800 1.5rem/1.1 var(--f-display);letter-spacing:-.02em;color:#fff}
  .p-sub{font-size:.88rem;color:rgba(255,255,255,.85);margin:4px 0 14px}
  .p-btn{align-self:flex-start;font-size:.78rem;font-weight:700;color:#1B0E04;background:var(--ember);padding:7px 14px;border-radius:9px}
  .p-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}
  .p-cards div{height:66px;border-radius:12px;background:rgba(255,255,255,.07);border:1px solid var(--line);animation:pop .5s ease backwards}
  .p-cards div:nth-child(1){animation-delay:3.1s}.p-cards div:nth-child(2){animation-delay:3.25s}.p-cards div:nth-child(3){animation-delay:3.4s}
  @keyframes pop{from{opacity:0;transform:translateY(12px)}}
  .chip{position:absolute;display:flex;align-items:center;gap:9px;font-size:.86rem;font-weight:700;padding:10px 15px;border-radius:13px;background:rgba(13,18,48,.92);border:1px solid var(--line2);box-shadow:0 18px 40px -12px rgba(0,0,0,.7);white-space:nowrap;animation:chipin .6s cubic-bezier(.3,1.5,.5,1) backwards,float 7s ease-in-out 5s infinite}
  .chip .i{width:1.15em;height:1.15em;stroke-width:2.2}
  .c-ssl{top:6px;right:-6px;animation-delay:2.6s,5s}.c-ssl .i{color:var(--ok)}
  .c-mail{bottom:8px;left:-14px;animation-delay:3.7s,6s}.c-mail .i{color:var(--cyan)}
  .c-google{bottom:70px;right:-10px;animation-delay:4.3s,7s}.c-google .i{color:var(--ember)}
  @keyframes chipin{from{opacity:0;transform:scale(.6) translateY(10px)}}
  @keyframes float{50%{transform:translateY(-8px)}}
  @media(max-width:940px){.stage{max-width:520px}.c-ssl{right:4px}.c-mail{left:4px}.c-google{right:4px}}

  /* ---------- VANTAGGI (bento) ---------- */
  .bento{display:grid;grid-template-columns:repeat(6,1fr);gap:18px}
  .b{position:relative;overflow:hidden;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:24px;padding:32px;transition:border-color .3s,background-color .3s}
  .b:hover{border-color:rgba(62,224,245,.4);background:rgba(255,255,255,.06)}
  .b{grid-column:span 2}.b4,.b5{grid-column:span 3}.b6{grid-column:span 6}
  .b .ico{display:grid;place-items:center;width:50px;height:50px;border-radius:15px;margin-bottom:22px;color:var(--cyan);background:rgba(62,224,245,.1);border:1px solid rgba(62,224,245,.25)}
  .b h3{font-size:1.35rem;margin-bottom:8px}
  .b p{color:#B7C0E0;font-size:1.02rem}
  .chips{list-style:none;display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
  .chips li{display:flex;align-items:center;gap:7px;font-size:.88rem;font-weight:500;padding:7px 13px;border-radius:999px;background:rgba(61,224,143,.1);border:1px solid rgba(61,224,143,.28);color:#CFF8E2}
  .chips .i{width:1em;height:1em;stroke-width:2.6;color:var(--ok)}
  .mini{display:inline-flex;align-items:center;gap:8px;margin-top:20px;font-size:.9rem;font-weight:700;padding:9px 14px;border-radius:12px;background:rgba(0,0,0,.35);border:1px solid var(--line2);color:#fff}
  .mini u{text-decoration:none;color:var(--cyan)}
  .mini em{font-style:normal;font-size:.76rem;font-weight:700;color:var(--ok);background:rgba(61,224,143,.12);padding:2px 8px;border-radius:999px}
  .b6{display:flex;align-items:center;gap:28px;background:linear-gradient(110deg,rgba(74,91,255,.28),rgba(62,224,245,.1) 60%,rgba(255,77,141,.1))}
  .b6 .ico{margin:0}
  .b6 p{max-width:70ch}
  @media(max-width:940px){.b,.b4{grid-column:span 3}.b5,.b6{grid-column:span 6}}
  @media(max-width:640px){.b,.b4,.b5,.b6{grid-column:span 6}.b{padding:26px}.b6{flex-direction:column;align-items:flex-start;gap:0}.b6 .ico{margin-bottom:22px}}

  /* ---------- CHI SIAMO ---------- */
  .about{position:relative;overflow:hidden;border:1px solid var(--line2);border-radius:32px;padding:clamp(30px,5vw,64px);background:linear-gradient(135deg,rgba(74,91,255,.22),rgba(13,18,48,.6) 55%,rgba(255,77,141,.1));box-shadow:0 40px 90px -30px rgba(0,0,0,.7)}
  .about::before{content:"";position:absolute;width:420px;height:420px;border-radius:50%;background:rgba(62,224,245,.18);filter:blur(110px);top:-190px;left:-120px;pointer-events:none}
  .about>*{position:relative}
  .about-top{display:grid;grid-template-columns:1.1fr .9fr;gap:28px 64px;align-items:start}
  .about h2{margin-bottom:0}
  .about-text p{color:var(--muted);font-size:1.1rem;margin-bottom:14px}
  .about-text strong{color:var(--text);font-weight:700}
  .about-text .out{color:var(--text);font-weight:500;font-size:1.2rem}
  .zone{display:inline-flex;align-items:center;gap:8px;margin-top:12px;font-weight:700;font-size:.92rem;padding:9px 16px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid var(--line2)}
  .zone .i{color:var(--ember);width:1.1em;height:1.1em}
  .pillars{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:44px}
  .pillar{padding:24px;border-radius:20px;background:rgba(7,10,28,.5);border:1px solid var(--line);transition:border-color .3s,transform .3s}
  .pillar:hover{border-color:rgba(62,224,245,.45);transform:translateY(-3px)}
  .pillar .i{width:1.6em;height:1.6em;color:var(--cyan);margin-bottom:14px}
  .pillar h3{font-size:1.12rem;margin-bottom:6px}
  .pillar p{color:var(--muted);font-size:.95rem}
  @media(max-width:900px){.about-top{grid-template-columns:1fr}.pillars{grid-template-columns:1fr}}

  /* ---------- COME FUNZIONA ---------- */
  .steps{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:30px;position:relative;counter-reset:s}
  .steps::before{content:"";position:absolute;top:21px;left:22px;right:22px;height:2px;background:linear-gradient(90deg,var(--cyan),var(--indigo) 65%,rgba(138,155,255,.1));opacity:.55}
  .step{position:relative;padding-top:68px}
  .step::before{counter-increment:s;content:counter(s);position:absolute;top:0;left:0;width:44px;height:44px;border-radius:50%;display:grid;place-items:center;font:800 1.05rem var(--f-display);background:var(--night);border:2px solid var(--cyan);color:var(--cyan);box-shadow:0 0 0 7px rgba(62,224,245,.08),0 0 26px rgba(62,224,245,.35)}
  .step h3{font-size:1.2rem;margin-bottom:8px}
  .step p{color:var(--muted);font-size:.97rem}
  @media(max-width:900px){
    .steps{grid-template-columns:1fr;gap:0}
    .steps::before{top:22px;bottom:22px;left:21px;right:auto;width:2px;height:auto}
    .step{padding:0 0 34px 72px}.step:last-child{padding-bottom:0}
  }

  /* ---------- PACCHETTI ---------- */
  .pricing{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;align-items:stretch;padding-top:16px}
  .plan{position:relative;display:flex;flex-direction:column;padding:38px 32px 34px;border-radius:26px;background:rgba(255,255,255,.04);border:1px solid var(--line);transition:border-color .3s,transform .3s}
  .plan:hover{border-color:rgba(138,155,255,.5)}
  .plan.featured{background:linear-gradient(180deg,rgba(45,58,150,.6),rgba(13,18,48,.92));transform:translateY(-16px);box-shadow:0 40px 90px -24px rgba(74,91,255,.55);border-color:transparent}
  .plan.featured::before{content:"";position:absolute;inset:0;border-radius:26px;padding:2px;background:conic-gradient(from var(--a),var(--cyan),#4A5BFF,var(--rose),var(--ember),var(--cyan));-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;animation:spin 7s linear infinite;pointer-events:none}
  @keyframes spin{to{--a:360deg}}
  .badge{position:absolute;top:-15px;left:32px;display:flex;align-items:center;gap:7px;background:var(--ember);color:#1B0E04;font-size:.84rem;font-weight:800;padding:6px 15px;border-radius:999px;box-shadow:0 10px 26px -8px rgba(255,138,61,.8)}
  .badge .i{width:1em;height:1em;fill:currentColor;stroke:none}
  .plan h3{font-size:1.35rem;letter-spacing:-.01em}
  .plan .for{color:var(--muted);font-size:.95rem;margin:6px 0 24px;min-height:50px}
  .price{display:flex;align-items:baseline;gap:8px;font:800 3.1rem/1 var(--f-display);letter-spacing:-.04em;white-space:nowrap}
  .price small{font:500 1rem var(--f-body);color:var(--muted);letter-spacing:0}
  .vat{color:var(--muted);font-size:.84rem;margin:6px 0 26px}
  .plan ul{list-style:none;margin-bottom:32px;flex:1}
  .plan li{display:flex;gap:11px;padding:10px 0;font-size:.97rem;border-top:1px solid var(--line)}
  .plan li:first-child{border-top:0}
  .plan li .i{width:1.1em;height:1.1em;margin-top:.28em;color:var(--ok);stroke-width:2.6}
  .plan li b{font-weight:700}
  .plan .btn{width:100%}
  @media(max-width:980px){.pricing{grid-template-columns:1fr;max-width:480px;margin-inline:auto}.plan.featured{transform:none}.plan .for{min-height:0}}

  .setup{margin-top:34px;display:grid;grid-template-columns:auto 1fr;gap:44px;align-items:center;padding:36px 42px;border-radius:26px;background:linear-gradient(120deg,rgba(74,91,255,.3),rgba(62,224,245,.1));border:1px solid rgba(138,155,255,.35)}
  .setup .big{font:800 3.4rem/1 var(--f-display);letter-spacing:-.04em}
  .setup .big small{display:block;font:500 .9rem var(--f-body);letter-spacing:0;color:var(--muted);margin-top:8px}
  .setup h3{font-size:1.2rem;margin-bottom:12px}
  .setup ul{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:8px 28px;font-size:.97rem}
  .setup li{display:flex;gap:10px;align-items:flex-start}
  .setup li .i{width:1.1em;height:1.1em;margin-top:.28em;color:var(--ok);stroke-width:2.6}
  @media(max-width:820px){.setup{grid-template-columns:1fr;gap:22px;padding:28px}.setup ul{grid-template-columns:1fr}}

  /* ---------- SERVIZI (schede) ---------- */
  .tabs{display:grid;grid-template-columns:320px 1fr;gap:24px;align-items:start}
  .tablist{display:flex;flex-direction:column;gap:10px}
  .tab{display:flex;align-items:center;gap:14px;width:100%;text-align:left;font:inherit;color:var(--text);padding:16px 18px;border-radius:18px;background:rgba(255,255,255,.04);border:1px solid var(--line);cursor:pointer;transition:background-color .25s,border-color .25s}
  .tab:hover{border-color:var(--line2)}
  .tab .ti{display:grid;place-items:center;flex:none;width:46px;height:46px;border-radius:14px;color:var(--cyan);background:rgba(62,224,245,.1);border:1px solid rgba(62,224,245,.22);transition:background-color .25s,color .25s}
  .tab b{display:block;font:700 1.02rem/1.25 var(--f-display);letter-spacing:-.01em}
  .tab small{display:block;color:var(--muted);font-size:.85rem}
  .tab[aria-selected="true"]{background:linear-gradient(120deg,rgba(74,91,255,.4),rgba(62,224,245,.14));border-color:rgba(138,155,255,.6)}
  .tab[aria-selected="true"] .ti{background:var(--cyan);color:var(--night)}
  .tabpanels{border-radius:26px;background:rgba(255,255,255,.04);border:1px solid var(--line);padding:clamp(24px,3.4vw,40px);min-height:100%}
  .svc-list{list-style:none;display:grid;grid-template-columns:1fr 1fr;gap:6px 36px}
